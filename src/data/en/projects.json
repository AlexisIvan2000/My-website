      "tagline": "Subscription and bill tracker",
      "type": "web",
      "accent": "#4f8ef7",
      "year": "2026",
      "status": "Live",
      "features": [
        {
          "title": "Subscriptions and bills",
          "text": "Two kinds of commitment, one way to track them: category, cadence, reminder lead time, and the amount both per charge and per year."
        },
        {
          "title": "Calendar of instalments",
          "text": "Every due date is a row written to the database ahead of time. One click marks it paid. On a phone the grid keeps its seven columns and switches to dots."
        },
        {
          "title": "Spending breakdown",
          "text": "Every category, not just the top five, and the heaviest lines ranked per year as well as per month."
        },
        {
          "title": "Multi-channel reminders",
          "text": "Before the due date, past due, trial ending: three families of alert, each switchable on its own, over email and web push, plus a Monday digest."
        }
