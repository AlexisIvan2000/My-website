    {
      "id": "commitclarify",
      "title": "CommitClarify",
      "tagline": "Automated GitHub repository analysis",
      "type": "web",
      "accent": "#d08a45",
      "year": "2026",
      "status": "Live",
      "features": [
        {
          "title": "Four agents in parallel",
          "text": "Exposed secrets, .gitignore, code quality, README checked against the actual code: four analyses launched together on one repository."
        },
        {
          "title": "Deterministic first",
          "text": "Ruff, ESLint and the filename scan produce reproducible findings. The LLM only handles what they cannot see."
        },
        {
          "title": "Live analysis progress",
          "text": "An SSE stream shows the real state of the run: fetching, indexing, analyzing, done."
        },
        {
          "title": "Exportable report",
          "text": "Every report reads inside the app and exports to PDF or JSON, in French as well as English."
        }
      ],
      "metrics": [
        {
