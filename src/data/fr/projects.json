      "tagline": "Analyse automatisée de dépôts GitHub",
      "type": "web",
      "accent": "#d08a45",
      "year": "2026",
      "status": "En ligne",
      "features": [
        {
          "title": "Quatre agents en parallèle",
          "text": "Secrets exposés, .gitignore, qualité du code, README confronté au code réel : quatre analyses lancées ensemble sur un même dépôt."
        },
        {
          "title": "Le déterministe d'abord",
          "text": "Ruff, ESLint et le scan des noms de fichiers produisent des résultats reproductibles. Le LLM ne traite que ce qu'ils ne savent pas voir."
        },
        {
          "title": "Analyse suivie en direct",
          "text": "Un flux SSE affiche l'état réel de l'analyse : récupération, indexation, analyse, terminé."
        },
        {
          "title": "Rapport exportable",
          "text": "Chaque rapport se lit dans l'application et s'exporte en PDF ou en JSON, en français comme en anglais."
        }
      ],
